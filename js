    var heroFish=C.fishOfKey(S.key);
    // losowe miejsce rzutu — CAŁY wędkarz IDZIE tam, żyłka leci pionowo spod niego DOPIERO PO DOJŚCIU
    var castSpot=C.clamp(Math.round(300+Math.random()*1320),300,1620);
    var newHeroX=castSpot-CFG.POS.heroSize*0.5;
    var WALK=Math.max(400,Math.min(1400,Math.abs(newHeroX-(parseFloat(EL['ca-hero'].style.left)||CFG.POS.heroX))*1.4));
    HX=castSpot+CFG.POS.lineOX; RODX=HX; rodTipX=HX; RODY=CFG.POS.heroY+CFG.POS.lineOY; rodTipY=RODY;

    // wielki cień zapowiada rzadką rybę
    var rare=(S.key==='serpent'||S.key==='quara'||S.key==='marlin');
    if(rare){ C.bigShadow(true,biteDepth); }

    // 1) wędkarz idzie do miejsca (chód + ewentualny tekst)
    heroPose('walk','...'); EL['ca-hero'].style.transition='left '+WALK+'ms cubic-bezier(.4,0,.3,1)'; EL['ca-hero'].style.left=newHeroX+'px';
    setPlayerHud('⏳','Wędkarz szuka miejsca...'); setAdminHud('zanurzanie...');
    if(rare)say('🌑 Coś wielkiego porusza się w głębinie...'); else say('🎣 Wędkarz wybiera miejsce...');

    // 2) PO DOJŚCIU — rzut: hak ląduje POD CZUBKIEM WĘDKI (żyłka prawie pionowa, naturalna)
    at(WALK+120,function(){
      EL['ca-hero'].style.transition='';  // chód skończony — zdejmij transition by rodTip był stabilny
      heroPose('cast','RZUT'); EL['ca-hook'].style.opacity=1; EL['ca-tag'].style.opacity=1; showWorm(true); startLine();
      say('🎣 Zarzuca przynętę nad toń Calassy...'); playSnd('cast');
      rodTip(); var sx=rodTipX, sy=rodTipY; RODY=rodTipY;  // realny czubek po dojściu (znacznik) — also reel target
      HX=rodTipX + (Math.random()*30-15);  // hak tuż pod czubkiem wędki (lekkie naturalne odchylenie)
      var t0=performance.now();
      (function arc(now){ var p=Math.min((now-t0)/CFG.T.cast,1);
        var x=sx+(HX-sx)*p, y=sy+(C.yFor(0)-sy)*p-Math.sin(p*Math.PI)*40; setHook(x,y); if(p<1)requestAnimationFrame(arc); })(t0);
      at(CFG.T.cast+150,function(){ heroPose('idle','SPŁAWIK'); C.splash(HX,C.yFor(0)); say('💧 <i>Plusk!</i> Przynęta na wodzie.'); });
      runDropSequence(S,biteDepth,weight,second,snap,heroFish,rare);
    });
  }
  // teksty wędkarza wg cierpliwości
  var MOOD_CALM=['Spokojnie... cierpliwość to klucz.','Czekam na ten jeden moment...','Toń jest dziś łaskawa.','No dawaj, rybko...'];
  var MOOD_ANNOYED=['No weź, bierz wreszcie!','Ile można czekać?!','Przestań się bawić, mała!','Grr, ta ryba mnie wkurza.','Czujesz robaka? Bierz!'];
  var MOOD_ANGRY=['BIERZ TO W KOŃCU!!! 😡','Mam dość tego cyrku!','Ja ci dam zabawę, gnido!','To jest WOJNA, rybo!','No już, bo wędkę połamię!'];
  var FALSE_BITE=['‼️ <b>Szarpnięcie!</b> ...nie, uciekła.','😤 Coś chwyciło i puściło!','〰️ <b>Niby bierze...</b> i znów nic!','🎣 Drgnęło! ...false alarm.','💢 Bawi się przynętą, bezczelna!'];
  function setMood(el,m){ EL['ca-hero'].classList.remove('annoyed','angry'); EL['ca-bubble'].classList.remove('mood-annoyed','mood-angry');
    if(m==='annoyed'){ EL['ca-hero'].classList.add('annoyed'); EL['ca-bubble'].classList.add('mood-annoyed'); }
    else if(m==='angry'){ EL['ca-hero'].classList.add('angry'); EL['ca-bubble'].classList.add('mood-angry'); } }

  // sekwencja fazowa: zwiad → tonięcie → fałszywe brania → zabawa przynętą → branie
  function runDropSequence(S,biteDepth,weight,second,snap,heroFish,rare){
    var scoutDepth=Math.min(15,Math.round(biteDepth*0.25));
    // FAZA 1: zwiad
    at(450,function(){ C.setPhase('scouting'); setPlayerHud('⏳','Zwiad płycizny...'); var ts=performance.now();
      (function s1(now){ var p=Math.min((now-ts)/1400,1); var d=Math.round(scoutDepth*p); setHook(HX+Math.sin(now/300)*4,C.yFor(d)); EL['ca-tag'].textContent=d+' m'; if(p<1)requestAnimationFrame(s1); })(ts);
      at(800,function(){ say(C.pick(SCOUT)); EL['ca-worm'].style.transform=''; });
    });
    at(1700,function(){ say('〰️ <i>Szarp...</i> nie, jeszcze nie to.'); setHook(HX+8,C.yFor(scoutDepth),'taut'); });
    at(2000,function(){ setHook(HX-6,C.yFor(scoutDepth)); });
    // FAZA 2: tonięcie do głębokości brania
    var tSink=CFG.T.scout;
    at(tSink,function(){ C.setPhase('sinking'); setPlayerHud('⏳','Przynęta tonie głębiej...'); setMood(null,'calm'); say(C.pick(MOOD_CALM)); var ts=performance.now(),dur=CFG.T.sink;
      (function sink(now){ var p=Math.min((now-ts)/dur,1); var e=p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2; var d=Math.round(scoutDepth+(biteDepth-scoutDepth)*e), x=HX+Math.sin(now/460)*5; setHook(x,C.yFor(d)); EL['ca-tag'].textContent=d+' m'; if(p<1)requestAnimationFrame(sink); })(ts);
    });
    at(tSink+CFG.T.sink*0.45,function(){ say(C.pick(STOPS)); });
    at(tSink+CFG.T.sink*0.8,function(){ if(heroFish){heroFish.willBite=true;heroFish.state='approach';} say('👁️ <b>'+S.name+'</b> kręci się przy przynęcie...'); });

    // FAZA 3: FAŁSZYWE BRANIA (ryba bawi się przynętą) — buduje napięcie
    var nFalse=CFG.FALSE_BITES, teaseStart=tSink+CFG.T.sink+400, gap=CFG.T.tease, t=teaseStart;
    for(var i=0;i<nFalse;i++){ (function(idx,tt){
      at(tt,function(){ C.setPhase('teasing'); setPlayerHud('🎣','Ryba bawi się przynętą...');
        var baseX=HX, baseYy=C.yFor(biteDepth), dir=(idx%2===0?1:-1);
        // płynne szarpnięcie w bok i w dół, potem powrót — żyłka zostaje przyczepiona
        var t0=performance.now();
        (function tug(now){ var p=Math.min((now-t0)/700,1); var k=Math.sin(p*Math.PI); // 0→1→0
          setHook(baseX+dir*22*k, baseYy+14*k, 'taut'); if(p<1)requestAnimationFrame(tug); else setHook(baseX,baseYy); })(t0);
        heroPose('tension','!'); say(C.pick(FALSE_BITE));
        var mood = idx>=nFalse-1?'angry' : idx>=1?'annoyed':'calm';
        at(280,function(){ setMood(null,mood); speak(C.pick(mood==='angry'?MOOD_ANGRY:mood==='annoyed'?MOOD_ANNOYED:MOOD_CALM)); });
        at(900,function(){ heroPose('idle',''); });
      });
    })(i,t); t+=gap; }

    // FAZA 4: PRAWDZIWE BRANIE
    at(t+400,function(){
      showWorm(false); C.bigShadow(false); setMood(null,'calm'); EL['ca-hero'].classList.remove('annoyed','angry'); EL['ca-bubble'].classList.remove('mood-annoyed','mood-angry');
      if(snap){ heroPose('tension','ZERWANA!'); say('🪢 <b>Żyłka pękła!</b> Przynęta i ryba przepadły...'); setPlayerHud('🌑','Zerwana żyłka — brak zwycięzcy'); setHook(HX,C.yFor(biteDepth),'danger'); playSnd('bite');
        at(2000,function(){ failReveal('Zerwana żyłka','Łup uciekł w mrok Calassy'); }); return; }
      heroPose('tension','BRANIE!'); say('🔱 <b>BRANIE!!!</b> '+S.name+' chwyta haczyk!'); setPlayerHud('⚔️','WALKA!'); playSnd('bite');
      if(heroFish){heroFish.state='caught';heroFish.caught=true;}
      EL['ca-biteLine'].style.top=C.sFor(biteDepth)+'px'; EL['ca-biteLine'].style.opacity=1; EL['ca-biteLabel'].textContent='BRANIE '+biteDepth+' m';
      // kamera stoi (bez zoomu) — żyłka stabilna podczas walki
      Object.keys(st().guesses).forEach(function(nl){ var g=st().guesses[nl]; var allow=g.isSub?(biteDepth+CFG.SUB_TOL):biteDepth; if(g.depth>allow){ C.markOver(nl,true); } }); C.flagBoardDirty();
      C.fishes.forEach(function(f){ if(!f.caught){f.state='leave';f.lvDir=Math.random()<.5?-1:1;} });
      at(700,function(){ fight(S,biteDepth,weight,second,heroFish); });
    });
  }

  // ── WALKA ──
  function fight(S,biteDepth,weight,second,heroFish){
    C.setPhase('fighting'); EL['ca-fightHud'].style.opacity=1;
    var stamina=100, tension=30, baseY=C.yFor(biteDepth), perBeat=100/(S.stamina+1), predatorTriggered=false;
    function upd(){ EL.sfill.style.width=stamina+'%'; EL.tfill.style.width=tension+'%'; EL.sfill.style.background=stamina<30?'linear-gradient(90deg,#ff9a5a,#ffd24a)':'linear-gradient(90deg,#34e6cf,#7fffb0)'; }
    upd();
    function beat(){
      if(stamina<=0){ winFight(); return; }
      // szansa na drapieżnika (raz, w okolicy połowy walki)
      if(!predatorTriggered && stamina<60 && Math.random()*100<CFG.PRED_CHANCE){
        var pred=C.findPredatorFor(S.name);
        if(pred){ predatorTriggered=true; predatorAttack(pred,S,biteDepth,weight,second,heroFish); return; }
      }
      var roll=Math.random();
      if(tension>78){ EL.manv.innerHTML=C.pick(DANGER); heroPose('tension','POPUŚĆ!'); setHook(HX+(Math.random()<.5?-10:10),baseY+18,'danger'); tension-=35; }
      else if(roll<0.42){ EL.manv.innerHTML=C.pick(DIVE).replace('{F}',S.name); heroPose('tension','TRZYMAJ'); tension+=22; stamina-=perBeat*0.7; setHook(HX+(Math.random()<.5?-8:8),baseY+30,'taut');
        EL['ca-stage'].animate([{transform:'scale('+fitScale+')'},{transform:'scale('+(fitScale*1.012)+')'},{transform:'scale('+fitScale+')'}],{duration:220}); }
      else if(roll<0.72){ EL.manv.innerHTML=C.pick(SIDE).replace('{F}',S.name); heroPose('tension','UWAGA!'); tension+=14; stamina-=perBeat*0.9; setHook(HX+(Math.random()<.5?-26:26),baseY+6,'taut'); }
      else { EL.manv.innerHTML=C.pick(TIRED).replace('{F}',S.name); heroPose('reel','HOLUJ!'); tension=Math.max(10,tension-18); stamina-=perBeat*1.8; baseY=Math.max(baseY-40,RODY+70); setHook(HX,baseY,''); }
      upd(); at(CFG.T.beat,beat);
    }
    function winFight(){ EL.manv.innerHTML='✨ <b>'+S.name+' pokonany!</b>'; heroPose('reel','WYCIĄGANIE'); EL.tfill.style.width='0%'; EL.sfill.style.width='0%';
      var t0=performance.now(),sy=C.hookPos.y; (function reel(now){ var p=Math.min((now-t0)/1400,1); setHook(HX,sy+(RODY-sy)*p,''); if(p<1)requestAnimationFrame(reel); })(t0);
      at(1600,function(){ reveal(S,biteDepth,weight,second); }); }
    beat();

    // DRAPIEŻNIK
    function predatorAttack(pred,prey,preyDepth,preyWeight,second,heroFish){
      C.setPhase('predator');
      say(C.pick(PRED_IN).replace(/{P}/g,pred.name).replace(/{F}/g,prey.name)); EL.manv.innerHTML='🦈 <b>'+pred.name+' porwał zdobycz!</b>';
      // podmień złowioną rybę wizualnie
      if(heroFish){ heroFish.caught=false; heroFish.state='leave'; heroFish.lvDir=1; }
      var predFish=C.fishOfKey(pred.key); if(predFish){ predFish.state='caught'; predFish.caught=true; }
      EL['ca-stage'].animate([{transform:'scale('+fitScale+')'},{transform:'scale('+(fitScale*1.03)+')'},{transform:'scale('+fitScale+')'}],{duration:380});
      var predDepth=C.clamp(Math.round(preyDepth*(0.85+Math.random()*0.3)),1,CFG.MAX_DEPTH);
      var predWeight=+(pred.weight[0]+Math.random()*(pred.weight[1]-pred.weight[0])).toFixed(1);
      // nowa walka z drapieżnikiem (krótsza, trudniejsza)
      var st2=100, tn=40, by=C.yFor(predDepth), pb=100/(pred.stamina+1);
      EL.tfill.style.width=tn+'%'; EL.sfill.style.width=st2+'%';
      at(1400,function(){ say('💪 Wędkarz mierzy się z <b>'+pred.name+'</b>!'); pbeat(); });
      function pbeat(){
        if(st2<=0){ EL.manv.innerHTML='👑 <b>'+pred.name+' pokonany!</b>'; heroPose('reel','WYCIĄGANIE');
          var t0=performance.now(),sy=C.hookPos.y;(function r(now){var p=Math.min((now-t0)/1400,1);setHook(HX,sy+(RODY-sy)*p,'');if(p<1)requestAnimationFrame(r);})(t0);
          at(1600,function(){ reveal(pred,predDepth,predWeight,null,true,prey.name); }); return; }
        var roll=Math.random();
        if(tn>80){ EL.manv.innerHTML=C.pick(DANGER); heroPose('tension','POPUŚĆ!'); setHook(HX+(Math.random()<.5?-12:12),by+20,'danger'); tn-=30; }
        else if(roll<0.55){ EL.manv.innerHTML=C.pick(DIVE).replace('{F}',pred.name); heroPose('tension','TRZYMAJ'); tn+=26; st2-=pb*0.7; setHook(HX+(Math.random()<.5?-12:12),by+34,'taut'); }
        else { EL.manv.innerHTML=C.pick(TIRED).replace('{F}',pred.name); heroPose('reel','HOLUJ!'); tn=Math.max(12,tn-16); st2-=pb*1.6; by=Math.max(by-40,RODY+70); setHook(HX,by,''); }
        EL.sfill.style.width=st2+'%'; EL.tfill.style.width=tn+'%'; at(CFG.T.beat,pbeat);
      }
    }
  }

  // ── REVEAL ──
  function reveal(S,biteDepth,weight,second,wasPredator,preyName){
    heroPose('win','TRIUMF!'); EL['ca-fightHud'].style.opacity=0; zoom(1); C.setPhase('reveal'); stopSnd('bite'); stopSnd('cast'); playSnd('win'); hideWife();
    // złowiona ryba przechodzi z walki (na haku) na czubek wędki (zwis trofeum)
    C.fishes.forEach(function(f){ if(f.caught){ f.landed=true; } });
    var winners=C.resolveWinners(biteDepth,second);
    winners.forEach(function(g){ if(g&&g.nl)C.markLead(g.nl,true); }); C.flagBoardDirty();
    EL['ca-rr'].textContent=S.emoji+' '+S.rr+(wasPredator?' · DRAPIEŻNIK':'');
    var rImg=S.reveal||S.gif;
    if(rImg){ EL['ca-art'].classList.add('has-img'); EL['ca-art'].style.backgroundImage="url('"+String(rImg).replace(/'/g,'%27')+"')";
      EL['ca-art'].style.backgroundPosition=(50+(S.revX||0))+'% '+(40+(S.revY||0))+'%'; EL['ca-art'].style.backgroundSize=Math.round((S.revScale||1)*100)+'%'; }
    else { EL['ca-art'].classList.remove('has-img'); EL['ca-art'].style.backgroundImage=''; EL['ca-art-emoji'].textContent=S.emoji; }
    EL['ca-nm'].textContent=S.name;
    EL['ca-st'].innerHTML='<span>Waga: <b>'+weight+' kg</b></span><span>Branie: <b>'+biteDepth+' m</b></span>';
    EL['ca-card'].classList.remove('fail');
    if(winners.length){
      var share=Math.floor(S.tc/winners.length);
      payout(winners,S,biteDepth,weight,share);
      pendingCatch={S:S,weight:weight,nick:winners[0].nick};  // ląduje na wieszaku przy następnym !start
      var w0=winners[0], names=winners.map(function(x){return C.esc(x.nick);}).join(', ');
      EL['ca-wn'].innerHTML='<div class="av" style="'+(CFG.USE_AVATAR?C.bgUrl(w0.avatar):'')+'"></div><div class="w">'+names+(winners.length>1?' (remis)':(' — typ '+w0.depth+' m'))+'</div>';
      EL['ca-po'].textContent='+'+share+' TC 💰'+(winners.length>1?' / os.':'');
      setPlayerHud('✅','Złowiono: '+C.esc(S.name));
      say((wasPredator?('🦈 '+C.esc(preyName)+' zjadł przynętę, ale <b>'+C.esc(names)+'</b> wyholował '+C.esc(S.name)+'! '):('🎉 <b>'+C.esc(names)+'</b> wyławia '+C.esc(S.name)+' '))+'('+weight+' kg) na '+biteDepth+' m! +'+share+' TC');
    } else {
      EL['ca-card'].classList.add('fail');
      EL['ca-wn'].innerHTML='<div class="w">Wszyscy przekroczyli branie…</div>'; EL['ca-po'].textContent='Brak zwycięzcy';
      setPlayerHud('🌑','Branie '+biteDepth+' m — wszyscy za głęboko!'); say('🌑 '+C.esc(S.name)+' wziął na '+biteDepth+' m — nikt nie łapie.');
      Object.keys(st().guesses).forEach(function(nl){ var p=C.player(nl,st().guesses[nl].nick); p.streak=0; }); C.saveData();
    }
    setAdminHud('<b>'+CFG.CMD.start+'</b> — nowe typy · <b>'+CFG.CMD.idle+'</b> — idle');
    EL['ca-rev'].classList.add('on'); requestAnimationFrame(function(){ requestAnimationFrame(function(){ EL['ca-card'].classList.add('in'); }); });
    at(CFG.T.reveal,function(){ EL['ca-rev'].classList.remove('on'); EL['ca-card'].classList.remove('in'); enterGallery(); });
  }
  // ── GALERIA (po reveal, czeka na komendę admina) ──

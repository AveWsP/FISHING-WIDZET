    C.spawnFish(); C.fishLoop(); C.buildDepthScale(); C.buildPlankton(); lineLoop(); fit(); window.addEventListener('resize',fit);
    C.buildObsPool(); requestAnimationFrame(C.boardLoop); C.startRotation();

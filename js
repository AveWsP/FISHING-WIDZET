  }

  function doReset(daily){ if(daily){ for(var n in C.DATA.players)C.DATA.players[n].dailyTC=0; C.DATA.meta.games=0; C.DATA.rack=[]; say('🌅 Reset dzienny.'); }
    else { C.DATA.players={}; C.DATA.records={}; C.DATA.rack=[]; C.DATA.meta={day:C.todayKey(),games:0}; say('🔄 Pełny reset Calassy.'); } C.saveNow(); C.renderLeaderboard(); C.renderRack(); }

  function route(nick,msg,isSub,isAdmin,avatar){
    var nl=C.lower(nick), m=C.lower(msg);
    if(isAdmin){ if(m===CFG.CMD.start){doStart();return;} if(m===CFG.CMD.lock){doLock();return;} if(m===CFG.CMD.drop){doDrop();return;}
      if(m===CFG.CMD.idle){goIdle();return;} if(m===CFG.CMD.rules){showRules(function(){goIdle();});return;}
      if(m===CFG.CMD.reset){doReset(false);return;} if(m===CFG.CMD.daily){doReset(true);return;} }
    if(m.indexOf(CFG.CMD.guess)===0){ var rest=msg.slice(CFG.CMD.guess.length).trim(); var n=parseInt(rest,10);
      if(!isNaN(n)){ C.handleGuess(nick,nl,n,isSub,avatar,msg);
        // wędkarz komentuje (z cooldownem), tylko w fazie otwartej
        var now=Date.now(); if(st().phase==='open' && now-lastCastComment>4500){ lastCastComment=now;
          at(300,function(){ if(st().phase==='open'){ speak(C.pick(CAST_COMMENT).replace('{n}',n)); at(2600,function(){ if(st().phase==='open')unspeak(); }); } });
        }
      } return; }
    if(m===CFG.CMD.mine){ showMine(nl,nick,avatar); return; }
    // zwykła wiadomość — jeśli gracz jest już obserwatorem, pokaż dymek z tym co napisał
    C.chatBubble(nl,msg);
  }

  // ── PANEL TESTOWY ──
  var BOTS=['Bananekk','Arascor','kipeerek','johnnyb','Pelcuu','melfonide','niter','szumi','LeQut','Drako','Vesper','Quaro','Maelis','Torin'];
  function addBot(forceSub){ if(st().phase!=='open')openRound(); var name=C.pick(BOTS)+Math.floor(Math.random()*90), d=1+Math.floor(Math.random()*CFG.MAX_DEPTH); C.handleGuess(name,C.lower(name),d,forceSub||Math.random()<0.25,'',String(d)); }
  function buildTestPanel(){ if(!CFG.TEST)return; var mount=EL['ca-testmount']; if(!mount)return;
    var wrap=document.createElement('div'); wrap.id='ca-tp';
    var opts=CFG.SPECIES.map(function(s){return '<option value="'+s.key+'">'+s.emoji+' '+s.name+'</option>';}).join('');
    wrap.innerHTML='<div class="tph"><span>🧪 TEST</span><span id="ca-tptg">▼</span></div><div class="tpb" id="ca-tpbody">'
      +'<div class="tps">Runda</div><div class="tprow"><button class="prim" data-a="start">'+CFG.CMD.start+'</button><button data-a="lock">'+CFG.CMD.lock+'</button><button class="prim" data-a="drop">'+CFG.CMD.drop+'</button><button data-a="idle">idle</button></div>'
      +'<div class="tps">Boty</div><div class="tprow"><button data-a="b1">+1</button><button data-a="b5">+5</button><button data-a="b10">+10</button><button data-a="bsub">+sub</button></div>'
      +'<div class="tps">Wymuś połów</div><select id="ca-tpsp">'+opts+'</select><div class="tprow"><button class="prim" data-a="force">▶ Złów wybrany</button></div>'
      +'<div class="tps">Inne</div><div class="tprow"><button data-a="rules">📖 zasady</button><button data-a="mine">📊 !moje</button><button class="dng" data-a="daily">🌅</button><button class="dng" data-a="reset">🔄</button></div></div>';
    mount.appendChild(wrap);
    wrap.querySelector('.tph').addEventListener('click',function(e){ if(e.target.tagName==='BUTTON'||e.target.tagName==='SELECT')return; var b=EL.$('ca-tpbody'),t=EL.$('ca-tptg'),sh=b.style.display==='none'; b.style.display=sh?'flex':'none'; t.textContent=sh?'▼':'▲'; });
    wrap.querySelectorAll('button[data-a]').forEach(function(btn){ btn.addEventListener('click',function(){ ta(btn.dataset.a); }); });
  }
  function ta(a){ switch(a){ case 'start':doStart();break; case 'lock':doLock();break; case 'drop':doDrop();break; case 'idle':goIdle();break;
    case 'b1':addBot();break; case 'b5':for(var i=0;i<5;i++)addBot();break; case 'b10':for(var j=0;j<10;j++)addBot();break; case 'bsub':addBot(true);break;
    case 'force':var k=EL.$('ca-tpsp').value; if(st().phase==='idle'){C.rollWeather();C.applyWeather();openRound();} doLock(); doDrop(k); break;
    case 'rules':showRules(function(){goIdle();});break; case 'mine':showMine('arascor','Arascor','');break; case 'daily':doReset(true);break; case 'reset':doReset(false);break; } }


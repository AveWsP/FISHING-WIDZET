  window.addEventListener('onEventReceived', function(obj){
    if(!obj.detail||obj.detail.listener!=='message')return; var d=(obj.detail.event&&obj.detail.event.data)||{};
    var nick=d.nick||d.displayName||''; var msg=(d.text||'').trim(); if(!nick||!msg)return;
    var isSub=!!(d.tags&&(d.tags.subscriber==='1'||d.tags.subscriber===true||d.tags.subscriber===1));
    var isMod=!!(d.tags&&(d.tags.mod==='1'||d.tags.mod===true||d.tags['user-type']==='mod'));
    var isBroad=(CFG.ADMIN&&C.lower(nick)===CFG.ADMIN)||(d.tags&&d.tags.badges&&/broadcaster/i.test(d.tags.badges));
    var avatar=d.avatar||(d.tags&&d.tags.avatar)||(d.user&&d.user.avatar)||'';
    if(!isPrimary())return;  // tylko główna instancja przetwarza czat
    route(nick,msg,isSub,isMod||isBroad,avatar);
  });

  function payout(winners,S,biteDepth,weight,share){
    var winSet={}; winners.forEach(function(w){winSet[w.nl]=1;});
    Object.keys(st().guesses).forEach(function(nl){ var g=st().guesses[nl], p=C.player(nl,g.nick,g.avatar);
      if(winSet[nl]){ p.totalTC+=share; p.dailyTC+=share; p.catches++; p.wins++; p.streak++; if(p.streak>p.bestStreak)p.bestStreak=p.streak; p.collection[S.name]=(p.collection[S.name]||0)+1;
        var rec=C.DATA.records[S.name]; if(!rec||weight>rec.weight)C.DATA.records[S.name]={weight:weight,nick:g.nick}; } else p.streak=0; });
    C.saveNow(); C.renderLeaderboard();
  }


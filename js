    EL['ca-obsLF'].style.left=P.obsLFx+'px'; EL['ca-obsLF'].style.top=P.obsLFy+'px'; EL['ca-obsLF'].style.gap=P.obsGap+'px';
    EL['ca-obsRN'].style.left=P.obsRNx+'px'; EL['ca-obsRN'].style.top=P.obsRNy+'px'; EL['ca-obsRN'].style.gap=P.obsGap+'px';
    EL['ca-obsRF'].style.left=P.obsRFx+'px'; EL['ca-obsRF'].style.top=P.obsRFy+'px'; EL['ca-obsRF'].style.gap=P.obsGap+'px';
    if(CFG.SHOW.sonar){ EL['ca-sonar'].style.right=CFG.POS.sonarX+'px'; EL['ca-sonar'].style.top=CFG.POS.sonarY+'px'; EL['ca-sonar'].style.width=CFG.POS.sonarW+'px'; EL['ca-sonar'].style.height=CFG.POS.sonarH+'px'; } else EL['ca-sonar'].style.display='none';
    if(CFG.SHOW.lb){ EL['ca-lb'].style.left=CFG.POS.lbX+'px'; EL['ca-lb'].style.top=CFG.POS.lbY+'px'; EL['ca-lb'].style.width=CFG.POS.lbW+'px'; } else EL['ca-lb'].style.display='none';
    if(!CFG.SHOW.godrays)EL['ca-godrays'].style.display='none';

  // FIX: render avatara jak w planszówce — url('...') z apostrofem, escape apostrofu
  function bgUrl(url){ if(!url)return ''; return "background-image:url('"+String(url).replace(/'/g,"%27")+"')"; }

  // geometria
  function sceneH(){ return CFG.POS.sceneH; }

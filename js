  function yFor(m){ var top=wTopY()+4; return top+(m/CFG.MAX_DEPTH)*(1044-top); }
  function sFor(m){ return 48+(m/CFG.MAX_DEPTH)*((CFG.POS.sonarH-66)); }

  // ── PERSYSTENCJA ──
  var STORE='ca_data_v3', DATA={players:{},records:{},rack:[],meta:{day:'',games:0}};
  function loadData(cb){ try{ if(typeof SE_API==='undefined'||!SE_API.store){ cb&&cb(); return; }
    SE_API.store.get(STORE).then(function(res){ var d=(res&&res[STORE])?res[STORE]:res;
      if(d&&d.players)DATA=d; if(!DATA.records)DATA.records={}; if(!DATA.rack)DATA.rack=[]; if(!DATA.meta)DATA.meta={day:'',games:0};
      maybeDailyReset(); cb&&cb();
    }).catch(function(){ cb&&cb(); }); }catch(e){ cb&&cb(); } }
  var _saveT=null;
  function saveNow(){ try{ if(typeof SE_API!=='undefined'&&SE_API.store) SE_API.store.set(STORE,DATA); }catch(e){} }
  function saveData(){ clearTimeout(_saveT); _saveT=setTimeout(saveNow,2500); }  // debounce: mniej kolizji last-write-wins przy tłumie
  function maybeDailyReset(){ var t=todayKey(); if(DATA.meta.day!==t){ for(var n in DATA.players)DATA.players[n].dailyTC=0; DATA.meta.day=t; DATA.meta.games=0; DATA.rack=[]; saveData(); } }
  function player(nl,nick,av){ if(!DATA.players[nl])DATA.players[nl]={nick:nick,avatar:av||'',totalTC:0,dailyTC:0,catches:0,wins:0,streak:0,bestStreak:0,collection:{}};
    var p=DATA.players[nl]; p.nick=nick; if(av)p.avatar=av; return p; }
  var RANKS=[[1500,'Legenda Głębin'],[700,'Mistrz'],[300,'Wędkarz'],[100,'Czeladnik'],[0,'Nowicjusz']];
  function rankTitle(tc){ for(var i=0;i<RANKS.length;i++) if(tc>=RANKS[i][0]) return RANKS[i][1]; return 'Nowicjusz'; }

  function renderLeaderboard(){ if(!EL['ca-lb-rows'])return;
    var arr=Object.keys(DATA.players).map(function(n){return DATA.players[n];}).filter(function(p){return p.dailyTC>0;});
    arr.sort(function(a,b){return b.dailyTC-a.dailyTC;}); var top=arr.slice(0,4),html='';
    if(!top.length)html='<div class="ca-lbrow empty">Brak połowów dziś — zarzuć żyłkę!</div>';
    top.forEach(function(p,i){ html+='<div class="ca-lbrow'+(i===1?' r2':i===2?' r3':'')+'">'
      +'<div class="rk">'+(i+1)+'</div><div class="av" style="'+(CFG.USE_AVATAR?bgUrl(p.avatar):'')+'"></div>'
      +'<div style="flex:1"><div class="nm">'+esc(p.nick)+'</div><div class="tt">'+rankTitle(p.totalTC)+(p.streak>1?' 🔥'+p.streak:'')+'</div></div>'
      +'<div class="tc">'+p.dailyTC+'</div></div>'; });
    EL['ca-lb-rows'].innerHTML=html;
    var best=null; for(var sp in DATA.records){ var r=DATA.records[sp]; if(!best||r.weight>best.weight)best={sp:sp,weight:r.weight,nick:r.nick}; }
    EL['ca-lb-record'].textContent=best?('🏅 Rekord: '+best.sp+' '+best.weight+' kg — '+best.nick):'🏅 Rekord: —';
  }

  // ── WIESZAK ──
  function addToRack(species,weight,nick){
    // GIF pływający gatunku (zawsze); fallback emoji
    DATA.rack.unshift({sp:species.name,emoji:species.emoji,gif:species.gif||'',sz:species.sz||80,weight:weight,nick:nick,t:Date.now()});
    if(DATA.rack.length>CFG.HANG_COUNT)DATA.rack.length=CFG.HANG_COUNT; saveData(); renderRack();
  }
  function renderRack(){ if(!EL['ca-rack']||!CFG.SHOW.rack)return;
    var P=CFG.POS;
    // slot 0 (najnowszy/pierwszy złowiony w tej serii) = PRAWY skraj; kolejne w LEWO co GAP
    // (DATA.rack[0] to ostatnio dodany — ale user chce: pierwszy złowiony = prawy.
    //  Trzymamy kolejność: najstarszy = prawy. rack.unshift dodaje na front, więc front=najnowszy.
    //  Pierwszy złowiony jest na końcu tablicy → mapujemy od końca do prawej.)
    var arr=DATA.rack.slice().reverse(); // [0]=najstarszy(pierwszy złowiony) → prawy
    var slot1X=P.rackSlot1X, gap=P.rackSlotGap, slotY=P.rackSlotY, sz=P.rackFishSz, rot=(P.rackFishRot||0);
    var html=arr.map(function(c,i){
      var x=slot1X - i*gap;  // pierwszy na prawo, kolejne w lewo
      var fishImg=c.gif?('<div class="ca-cfish has-img" style="'+bgUrl(c.gif)+';width:'+sz+'px;height:'+sz+'px;transform:rotate('+rot+'deg)"></div>')
                       :('<div class="ca-cfish" style="font-size:'+(sz*0.7)+'px;transform:rotate('+rot+'deg)">'+(c.emoji||'🐟')+'</div>');
      return '<div class="ca-catch" style="left:'+x+'px;top:'+slotY+'px">'
        +'<div class="ca-rope"></div>'+fishImg
        +'<div class="ca-clabel">'+esc(c.sp)+'<br><b>'+c.weight+'kg</b></div></div>';
    }).join('');
    EL['ca-rack'].innerHTML=html;
  }

